{
  "malware_family": "RemotePE (DPAPILoader / RemotePELoader / RemotePE toolset)",
  "threat_actor": "Lazarus subgroup (overlaps AppleJeus, Citrine Sleet, UNC4736, Gleaming Pisces)",
  "platforms": [
    "windows"
  ],
  "summary": "DPAPILoader is an environmentally keyed first-stage DLL that decrypts a DPAPI-protected, 0x8D-XORed RemotePELoader payload from the DeviceMetadataStore directory, then reflectively loads it with libpeconv. RemotePELoader applies HellsGate/TartarusGate unhooking and ETW patching before polling an HTTP C2 for the final RemotePE RAT, which executes entirely in memory and exposes RTTI-based command classes. Detection anchors include masquerading service DLLs (Iassvc.dll), DPAPI-encrypted blobs in DeviceMetadataStore, the ETW patch bytes 48 33 c0 c3, the wake-up event 554D5C1F-AABE-49E4-AB57-994D22ECED28 and the cookie/JSON keys MicrosoftApplicationsTelemetryDeviceId, at_check, ai_session, MSFPC, MUID and armAuthorization.",
  "mitre_techniques": [
    "T1480.001",
    "T1620",
    "T1543.003",
    "T1574.002",
    "T1562.001",
    "T1071.001",
    "T1070.004"
  ],
