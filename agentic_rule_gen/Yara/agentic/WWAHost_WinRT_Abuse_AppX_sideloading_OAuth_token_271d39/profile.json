{
  "malware_family": "WWAHost WinRT Abuse (AppX sideloading OAuth token theft)",
  "threat_actor": "",
  "platforms": [
    "windows"
  ],
  "summary": "A post-compromise technique sideloads a minimal AppX package whose ContentUriRules grants WindowsRuntimeAccess=\"all\", so Microsoft-signed WWAHost.exe renders attacker JavaScript with full WinRT access and abuses WebAuthenticationBroker with Microsoft Office's first-party client ID to capture real OAuth authorization codes, access tokens and refresh tokens. Every component is Microsoft-signed and the login is genuine, so detection keys on the EdgeHTML user agent MSAppHost/3.0 (Edge/18) reaching non-Microsoft destinations from an AppX web host. Stolen refresh tokens give MFA-surviving Microsoft 365 access that scales with the victim's privileges.",
  "mitre_techniques": [
    "T1528",
    "T1550.001"
  ],
