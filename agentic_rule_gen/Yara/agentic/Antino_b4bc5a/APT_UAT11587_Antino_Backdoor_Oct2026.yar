/* Self-check
[x] Every string has a provenance comment
[x] No source-code identifiers / compiled-away names
[x] Hash-gated values use the hash constant, not the plaintext
[x] No substring redundancy within any "N of" group
[x] No generic string can trigger the rule alone
[x] Description matches the condition
[x] Open-source-tool features are not attributed to the actor
[x] Unique build identifiers (typelib GUID, PDB, keys/salts, mutexes) are $x, not downgraded
[x] No generic padding is required by the condition
[x] No empty meta fields
*/
rule APT_UAT11587_Antino_Backdoor_Oct2026 {
    meta:
        author = "ioc-yara-daily (agentic)"
        description = "Detects the Antino backdoor used by UAT-11587. The rule matches on unique PDB paths, a specific PowerShell persistence command, or a combination of strings related to C2 and command handling. A match can be triggered by any unique PDB path, the PowerShell command, or 4 of the supporting strings."
        reference = "https://blog.talosintelligence.com/china-nexus-uat-11587-targets-government-and-policy-organizations-across-asia-with-antino-backdoor/"
        date = "2026-10-16"
        hash1 = "09ef7c736bccfafefc44d9910d499173b88063b73b221fc0dc9e9105107e5cff"
        hash2 = "e2eb7703047b37b28dc34e6990205d758a2454b39bc655b460606745fadcb530"
        hash3 = "e7e3b0bcd6798634adf8b49d305f3a7b7682e4b76db549682a183c5a186df4bb"
        hash4 = "1fadc90b61ce536abda78eb387a7f3d745f00c16775d3f762845ccc0fde567da"
        hash5 = "0c39264337a1186b2e765e24073399cbdcba118306614eb411e315887af578bd"
        tlp = "WHITE"
        status = "untested"
        test_result = "not tested: hash1, hash2, hash3, hash4, hash5 not available locally — the pipeline does not download malware; put samples in ioc-yara-daily/samples/ (any file name) to test"
        score = 60
        unverified_strings = "$s_res"

    strings:
        // PDB Paths - Strong Anchors
        $x_pdb1 = "D:\\a\\antino\\antino\\target\\x86_64-pc-windows-msvc\\release\\deps\\antino_client_template.pdb" ascii wide // source: explicit_literal
        $x_pdb2 = "D:\\a\\antino\\antino\\target\\i686-pc-windows-msvc\\release\\deps\\antino_client_template.pdb" ascii wide // source: explicit_literal
        $x_pdb3 = "D:\\a\\antino\\antino\\target\\x86_64-pc-windows msvc\\release\\deps\\slc_template.pdb" ascii wide // source: explicit_literal

        // PowerShell Persistence - Strong Anchor
        $x_ps1 = "New-ItemProperty -Path 'HKCU:\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run' -Name $name -PropertyType String -Value $value -ErrorAction Stop" ascii wide // source: Figure 22. PowerShell script generated by Antino’s add_to_run command.

        // Supporting Strings
        $s1 = "?$filter=subject+eq+'command_req_" ascii wide // source: Figure 18. Request from Antino to Outlook to get commands from emails.
        $s2 = "AntinoApp" ascii // source: figure_or_disassembly
        $s3 = "command_type" ascii wide // source: Figure 19. The JSON sent in command request message.
        $s4 = "command_data" ascii wide // source: Figure 19. The JSON sent in command request message.
        $s5 = "working_dir" ascii wide // source: Figure 19. The JSON sent in command request message.
        $s6 = "load_shellcode" ascii wide // source: Figure 21. The load_shellcode command structure.
        $s7 = "use_sleep_mask" ascii wide // source: Figure 21. The load_shellcode command structure.
        $s8 = "use_restart_mode" ascii wide // source: Figure 21. The load_shellcode command structure.
        $s9 = "system_info" ascii wide // source: Figure 17. Example heartbeat JSON.
        $s10 = "machine_name" ascii wide // source: Figure 17. Example heartbeat JSON.
        $s_res = "command_res_" ascii wide // source: prose

    condition:
        uint16(0) == 0x5a4d and filesize < 20MB and
        (
            1 of ($x_pdb*) or
            $x_ps1 or
            4 of ($s*)
        )
}
