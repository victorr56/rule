  "platforms": [
    "android"
  ],
  "summary": "BTMOB is an Android remote access trojan evolved from SpySolr, sold as malware-as-a-service with an APK builder that lets operators cheaply generate phishing payloads and tailor lures per region. It spreads via fake app stores impersonating streaming, crypto-mining and government services, then abuses Android Accessibility Services to grant itself broad permissions, exfiltrate data, capture screenshots/recordings and take remote control of the device. Rapid payload turnover means indicators age quickly, though recurring infrastructure patterns remain useful for triage.",
  "mitre_techniques": [
    "T1626",
    "T1636",
    "T1513",
    "T1512",
    "T1430"
  ],
