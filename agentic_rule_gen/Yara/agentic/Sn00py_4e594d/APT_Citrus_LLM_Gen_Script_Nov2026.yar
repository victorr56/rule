/* Self-check
[x] Every string has a provenance comment
[x] No source-code identifiers / compiled-away names
[x] Hash-gated values use the hash constant, not the plaintext
[x] No substring redundancy within any "N of" group
[x] No generic string can trigger the rule alone
[x] Description matches the condition
[x] Open-source-tool features are not attributed to the actor
[x] Unique build identifiers (typelib GUID, PDB, keys/salts, mutexes) are $x, not downgraded
[x] No generic padding is required by the condition
[x] No empty meta fields
*/
rule APT_Citrus_LLM_Gen_Script_Nov2026
{
    meta:
        author = "ioc-yara-daily (agentic)"
        date = "2026-11-11"
        description = "Detects PowerShell scripts generated by Large Language Models (LLMs) and used by the Citrus threat group. The rule identifies unique comments left in the scripts, requiring a specific long and unique comment to trigger."
        reference = "https://securelist.com/citrus-ransomware/121879/"
        tlp = "WHITE"
        status = "untested"
        test_result = "not tested: the report gives no sample hash for this rule"
        score = 60
        threat_actor = "Citrus"

    strings:
        $x1 = "# Creating background tasks for each computer with a thread limit" ascii  // source: figure_or_disassembly

    condition:
        filesize < 1MB and
        // Ensure this doesn't hit a PE file
        not uint16(0) == 0x5a4d and
        1 of ($x*)
}
